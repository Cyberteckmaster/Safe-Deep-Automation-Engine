# Environment Configuration for Safe-Deep Automation Engine

# LLM Provider Configuration
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here

# Model Settings
LLM_MODEL=gpt-4-turbo-preview
TEMPERATURE=0.7
MAX_TOKENS=4096

# Output Settings
OUTPUT_FORMAT=html
DEPTH_LEVEL=high
INCLUDE_SCHEMA=true

# Research Settings
MIN_SOURCES=3
MAX_SOURCES=10
VERIFICATION_ENABLED=true

# API Server (Optional)
PORT=3000
API_ENABLED=false

# Database (Optional)
DB_ENABLED=false
DB_CONNECTION_STRING=mongodb://localhost:27017/safe-deep

# Logging
LOG_LEVEL=info
LOG_FILE=logs/engine.log
